# .env for the cPanel host. Copy to <DEPLOY_PATH>/.env and fill the blanks.
# APP_KEY MUST be the same value as on 103.174.102.91 — every saved token and
# password in the shared database is encrypted with it.
APP_NAME="IVF CRM"
APP_ENV=production
APP_KEY=base64:PASTE_THE_KEY_FROM_THE_VPS_ENV
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://your-domain.example

LOG_CHANNEL=daily
LOG_LEVEL=warning

# The database stays on the VPS (see deploy/vps-allow-remote-db.sh).
DB_CONNECTION=mysql
DB_HOST=103.174.102.91
DB_PORT=3306
DB_DATABASE=ivfcrm
DB_USERNAME=ivfcrm_cpanel
DB_PASSWORD=

# cPanel has no Redis: everything shared lives in the database tables the
# app already ships (cache, sessions, jobs). Do not use "file" — the token
# cache must be one store for the web app and the cron worker.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=720
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# Copy the rest of the integration keys from the VPS .env if any are set
# there (META_*, TATA_*, GOOGLE_*). Values saved through Settings screens are
# in the database and need nothing here.
