APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Meta / WhatsApp Business (optional) -------------------------------------
# Credentials are normally entered in the app under Settings → Integrations and
# stored encrypted in the `settings` table. The values below are only bootstrap
# fallbacks for local development.
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_PIXEL_ID=

WHATSAPP_MEDIA_DISK=local
WHATSAPP_MAX_UPLOAD_MB=16
WHATSAPP_BROADCAST_RPM=60

# --- Telephony: Asterisk + MicroSIP (optional) --------------------------------
# AMI credentials are normally entered under Settings → Telephony and stored
# encrypted. These are bootstrap fallbacks for local development only.
ASTERISK_ENABLED=true
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=
ASTERISK_CONTEXT=from-internal
ASTERISK_TECHNOLOGY=PJSIP
ASTERISK_TRUNK=
ASTERISK_OUTBOUND_PREFIX=
ASTERISK_CALLER_ID="IVF CRM"
ASTERISK_ORIGINATE_TIMEOUT=30
ASTERISK_WEBHOOK_TOKEN=
ASTERISK_RECORDING_ENABLED=true
ASTERISK_RECORDING_DISK=local
ASTERISK_RECORDING_PATH=call-recordings
ASTERISK_RECORDING_SERVER_PATH=/var/spool/asterisk/monitor

MICROSIP_STUN_SERVER=

# WhatsApp Business Calling. Prefer SIP routing: Meta delivers the call to your
# own Asterisk, so it rings the agent's MicroSIP extension via the dial plan.
WHATSAPP_CALLING_ENABLED=true
WHATSAPP_CALL_HOURS_TZ=Asia/Kolkata
WHATSAPP_CALL_BRIDGE_ENABLED=false
TELEPHONY_WRAPUP_SECONDS=30
